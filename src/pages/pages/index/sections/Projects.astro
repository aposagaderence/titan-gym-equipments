---
import Card from "../../../components/Card.astro";
---

<section class="projects section-wrap" id="projects" aria-labelledby="projects-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow">MADE FOR EVERY TRAINING SPACE</p>
      <h2 id="projects-title">Start where you are.</h2>
    </div>
    <span class="section-count">01 — 03</span>
  </div>
  <div class="project-grid">
    <Card
      label="01 / HOME"
      title="The home setup"
      desc="Make every square metre count with the essentials for everyday strength."
    />
    <Card
      label="02 / STUDIO"
      title="The training studio"
      desc="Build a simple, versatile foundation for focused small-group sessions."
    />
    <Card
      label="03 / GYM"
      title="The strength floor"
      desc="Bring together the racks, benches, and weights for serious training."
    />
  </div>
</section>
